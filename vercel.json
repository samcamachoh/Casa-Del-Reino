{
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/welcome", "destination": "/index.html" },
    { "source": "/sermons", "destination": "/index.html" },
    { "source": "/ministries", "destination": "/index.html" },
    { "source": "/giving", "destination": "/index.html" },
    { "source": "/visit", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|ico|svg|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(index\\.html|about\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
